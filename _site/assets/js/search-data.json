l id="svg-search" viewBox="0 0 24 24"> <title>Search</title> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg> </symbol> <!-- Bootstrap Icons. MIT License: https://github.com/twbs/icons/blob/main/LICENSE.md --> <symbol id="svg-copy" viewBox="0 0 16 16"> <title>Copy</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16"> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/> <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/> </svg> </symbol> <symbol id="svg-copied" viewBox="0 0 16 16"> <title>Copied</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-check-fill" viewBox="0 0 16 16"> <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3Zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3Z"/> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5v-1Zm6.854 7.354-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708.708Z"/> </svg> </symbol> </svg> <div class="side-bar"> <div class="site-header" role="banner"> <a href="/" class="site-title lh-tight"> POS Kitchen Screen </a> <button id="menu-button" class="site-button btn-reset" aria-label="Toggle menu" aria-pressed="false"> <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use xlink:href="#svg-menu"></use></svg> </button> </div> <nav aria-label="Main" id="site-nav" class="site-nav"> <ul class="nav-list"><li class="nav-list-item"><a href="/" class="nav-list-link">Home</a></li><li class="nav-list-item"><a href="/setup.html" class="nav-list-link">Setup</a></li><li class="nav-list-item"><a href="/troubleshooting.html" class="nav-list-link">Troubleshooting</a></li></ul> </nav> <footer class="site-footer"> This site uses <a href="https://github.com/just-the-docs/just-the-docs">Just the Docs</a>, a documentation theme for Jekyll. </footer> </div> <div class="main" id="top"> <div id="main-header" class="main-header"> <div class="search" role="search"> <div class="search-input-wrap"> <input type="text" id="search-input" class="search-input" tabindex="0" placeholder="Search POS Kitchen Screen" aria-label="Search POS Kitchen Screen" autocomplete="off"> <label for="search-input" class="search-label"><svg viewBox="0 0 24 24" class="search-icon"><use xlink:href="#svg-search"></use></svg></label> </div> <div id="search-results" class="search-results"></div> </div> <nav aria-label="Auxiliary" class="aux-nav"> <ul class="aux-nav-list"> <li class="aux-nav-list-item"> <a href="https://apps.odoo.com/apps/modules/18.0/abichinger_kitchen_screen" class="site-button" > Odoo Apps </a> </li> <li class="aux-nav-list-item"> <a href="https://odoo-demo.duckdns.org/web#action=point_of_sale.action_pos_config_kanban" class="site-button" > Demo </a> </li> </ul> </nav> </div> <div class="main-content-wrap"> <div id="main-content" class="main-content"> <main> <h{"0": { "doc": "Home", "title": "POS Kitchen Screen (Odoo KDS)", "content": "The POS Kitchen Screen module enhances kitchen efficiency by providing real-time order synchronization, clear progress tracking, and a responsive interface optimized for tablets and large screens. ", "url": "/#pos-kitchen-screen-odoo-kds", "relUrl": "/#pos-kitchen-screen-odoo-kds" },"1": { "doc": "Home", "title": "Features", "content": ". | Real-time orders: Orders are displayed instantly as they’re taken in POS. | Progress tracking: Status flows through Cooking → Ready → Done. | Merge order changes: Optionally merge subsequent changes into the original order view. | Overdue alerts: Orders exceeding configured prep time turn orange then red. | Product variants: Clear variant information on order lines. | Print on demand: Print from the kitchen screen via: . | POS ePos Printer (e.g., Epson) | POS Kitchen Printers | A local browser printer connected to the screen | . | Deactivate dishes: Quickly mark products unavailable directly from the screen. | Requires module abichinger_pos_stock to enable/disable dishes. | . | Internal notes: Show internal notes on order lines. | Overview panel: Aggregated counts of all items in preparation. | Notification sound: Play a sound for new orders (configurable). | Order sorting: Sort by tracking number or preparation time. | Multiple PoS sessions: Combine multiple PoS sessions on one display. | . ", "url": "/#features", "relUrl": "/#features" },"2": { "doc": "Home", "title": "Links", "content": ". | Odoo Apps: https://apps.odoo.com/apps/modules/18.0/abichinger_kitchen_screen | Live Demo: https://odoo-demo.duckdns.org/web#action=point_of_sale.action_pos_config_kanban | . ", "url": "/#links", "relUrl": "/#links" },"3": { "doc": "Home", "title": "Home", "content": " ", "url": "/", "relUrl": "/" },"4": { "doc": "Setup", "title": "Requirements", "content": ". | Odoo Community or Enterprise | Optional: abichinger_pos_stock for enabling/disabling dishes from the screen | Optional: aks_self_order to show orders from the self-order menu | . ", "url": "/setup.html#requirements", "relUrl": "/setup.html#requirements" },"5": { "doc": "Setup", "title": "Installation", "content": ". | Place abichinger_kitchen_screen in your addons path. | Common default addons paths (check your odoo.conf → addons_path): . | Windows: C:\\Program Files\\Odoo &lt;version&gt;\\server\\addons | Linux: /usr/lib/python3/dist-packages/odoo/addons (package install) or &lt;odoo_source&gt;/addons | macOS: &lt;venv&gt;/lib/python3.x/site-packages/odoo/addons (pip/venv) or &lt;odoo_source&gt;/addons | . | . | Update app list and install the module from Apps. | . ", "url": "/setup.html#installation", "relUrl": "/setup.html#installation" },"6": { "doc": "Setup", "title": "Configuration", "content": ". | Open the Kitchen Screen menu and create a record: . | Name: e.g., Main Kitchen | Point of Sale: Select one or more PoS configurations | Current wait time (requires aks_self_order): Minutes shown to customers (set to 0 to disable) | Custom filter: Domain to restrict orders (advanced) | Orderline groups (orderline_group_ids): Define stages (like Appetizer, Main, Dessert) that group order lines on the screen. Add items in the “Orderline Groups” tab: . | Sequence: Determines the order of stages | Name: Stage title | POS Categories: Categories to include (subcategories are included automatically) | Product Attributes: Optional attribute values to include | . | . | Printers (optional): . | Configure ePos/Kitchen printers in POS settings | Or use a local browser printer connected to the device running the screen | . | Launch the screen: . | From the Kitchen Screen record (opens /abichinger_kitchen_screen/app/?ks=&lt;id&gt;) | Or via the button in the POS kanban view | . | . ", "url": "/setup.html#configuration", "relUrl": "/setup.html#configuration" },"7": { "doc": "Setup", "title": "WebSocket/Proxy Setup", "content": "If Odoo runs behind a reverse proxy, configure WebSocket support as follows. Multi-threaded (--workers 0) . The multi-threaded server is the default server, also for docker containers. It is selected by leaving the --workers option out or setting it to 0 [1] . If you are running Odoo behind a proxy in multi-threaded mode you need to set --proxy-mode and enable Websocket proxying. upstream odoo { server 127.0.0.1:8069; } map $http_upgrade $connection_upgrade { default upgrade; '' close; } # http -&gt; https server { listen 80; server_name odoo.mycompany.com; rewrite ^(.*) https://$host$1 permanent; } server { listen 443 ssl; # &lt;Your server configuration&gt; location { proxy_pass http://odoo; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; # &lt;Your location configuration&gt; } } . Multi-processing (--workers &lt;NUM_WORKERS&gt;) . In multi-processing, a dedicated LiveChat worker is automatically started and listens on the --gevent-port. You must deploy a proxy in front of Odoo and redirect incoming requests whose path starts with /websocket/ to the LiveChat worker. You must also start Odoo in --proxy-mode so it uses the real client headers (such as hostname, scheme, and IP) instead of the proxy ones. [1] . Multi-processing Configuration sample . ", "url": "/setup.html#websocketproxy-setup", "relUrl": "/setup.html#websocketproxy-setup" },"8": { "doc": "Setup", "title": "Setup", "content": " ", "url": "/setup.html", "relUrl": "/setup.html" },"9": { "doc": "Troubleshooting", "title": "Screen does not update in real time", "content": ". | Ensure reverse proxy passes WebSocket upgrade headers (see WebSocket/Proxy Setup) | Run Odoo with --proxy-mode when behind a proxy | . ", "url": "/troubleshooting.html#screen-does-not-update-in-real-time", "relUrl": "/troubleshooting.html#screen-does-not-update-in-real-time" },"10": { "doc": "Troubleshooting", "title": "Printing issues", "content": ". | Confirm printers are configured in POS (ePos or Kitchen Printers) | For local browser printing, test printing from the device directly | . ", "url": "/troubleshooting.html#printing-issues", "relUrl": "/troubleshooting.html#printing-issues" },"11": { "doc": "Troubleshooting", "title": "Products not appearing / filtering too strict", "content": ". | Products must be available in POS and saleable | Kitchen Screen applies category filters from the selected PoS plus child categories | Review the record’s Custom filter (domain) and simplify for testing | . ", "url": "/troubleshooting.html#products-not-appearing--filtering-too-strict", "relUrl": "/troubleshooting.html#products-not-appearing--filtering-too-strict" },"12": { "doc": "Troubleshooting", "title": "Deactivate dishes not working", "content": ". | Install abichinger_pos_stock | Verify the product is available in POS | . ", "url": "/troubleshooting.html#deactivate-dishes-not-working", "relUrl": "/troubleshooting.html#deactivate-dishes-not-working" },"13": { "doc": "Troubleshooting", "title": "Troubleshooting", "content": " ", "url": "/troubleshooting.html", "relUrl": "/troubleshooting.html" } } </main> </div> </div> <div class="search-overlay"></div> </div> </body> </html>
